{
  "name": "@ceeblue/videojs-plugins",
  "version": "1.2.0",
  "description": "Videojs set of plugins for playing streams from the Ceeblue cloud. Supports WebRTC and WHEP, video quality switching, protocol fallbacks, and more.",
  "browserslist": "chrome >= 63",
  "keywords": [
    "webrtc",
    "whip",
    "whep",
    "real-time",
    "streaming",
    "video",
    "live",
    "cdn",
    "hls",
    "dash",
    "videojs",
    "videojs-plugin"
  ],
  "homepage": "https://github.com/CeeblueTV/videojs-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CeeblueTV/videojs-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/CeeblueTV/videojs-plugins/issues"
  },
  "module": "dist/videojs-plugins.es.js",
  "browser": "dist/videojs-plugins.js",
  "scripts": {
    "build": "npm run clean && (NO_TEST_BUNDLE=1 npm run build:js & npm run build:css & wait)",
    "build-prod": "npm run build",
    "build-test": "npm run clean && TEST_BUNDLE_ONLY=1 npm run build:js",
    "build:css": "postcss -o dist/videojs-plugins.css --config scripts/postcss.config.js src/plugin.scss",
    "build:js": "rollup -c rollup.config.ts",
    "clean": "rm -rf ./dist ./test/dist ./cjs ./es && mkdir -p ./dist ./test/dist ./cjs ./es",
    "docs": "npm run build && npm run docs:build && npm run docs:copy",
    "docs:build": "vitepress build docs",
    "docs:copy": "mkdir -p docs/.vitepress/dist/dist && cp -r docs/public/. docs/.vitepress/dist/ && cp -r dist/. docs/.vitepress/dist/dist/",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "server": "vitepress dev docs",
    "start": "npm run server & npm run watch",
    "test": "vitest run --project ci",
    "test:browser": "vitest run --project browser",
    "test:chrome": "TEST_BROWSER=chrome vitest run --project browser",
    "test:firefox": "TEST_BROWSER=firefox vitest run --project browser",
    "test:edge": "TEST_BROWSER=edge vitest run --project browser",
    "test:safari": "TEST_BROWSER=safari vitest run --project browser",
    "test:open": "TEST_HEADLESS=false vitest --project browser -w",
    "test:coverage": "vitest run --project ci --coverage",
    "prepare": "is-ci || simple-git-hooks",
    "prepublishOnly": "npm run build-prod",
    "watch": "vite build --watch",
    "watch:css": "npm run build:css -- -w"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run build",
    "commit-msg": "npx --no -- commitlint --edit $1"
  },
  "author": "Ceeblue B.V.",
  "license": "AGPL-3.0-or-later",
  "files": [
    "cjs/",
    "dist/",
    "docs/",
    "es/"
  ],
  "dependencies": {
    "@ceeblue/webrtc-client": "^5.2.0",
    "@ceeblue/wrts-client": "^1.1.0",
    "video.js": "^8.22.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@html-eslint/eslint-plugin": "^0.39.0",
    "@html-eslint/parser": "^0.39.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-multi-entry": "^6.0.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@vitest/browser": "^3.1.1",
    "@vitest/coverage-v8": "^3.1.2",
    "eslint": "^9.25.1",
    "eslint-plugin-jsdoc": "^50.6.10",
    "eslint-plugin-markdown": "^5.1.0",
    "globals": "^16.0.0",
    "is-ci": "~3.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "~15.5.2",
    "markdown-it-container": "^4.0.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^8.3.1",
    "rollup": "^4.40.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "rollup-plugin-istanbul": "^5.0.0",
    "semantic-release": "^25.0.1",
    "simple-git-hooks": "^2.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite-plugin-monaco-editor": "1.1.0",
    "vitepress": "^1.6.3",
    "vitest": "^3.1.1",
    "webdriverio": "^9.12.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "dompurify": "^3.4.1"
  },
  "type": "module"
}
