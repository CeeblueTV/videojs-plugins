{
  "name": "@ceeblue/videojs-plugins",
  "version": "1.2.0",
  "description": "Videojs set of plugins for playing streams from the Ceeblue cloud. Supports WebRTC and WHEP, video quality switching, protocol fallbacks, and more.",
  "browserslist": "chrome >= 63",
  "keywords": [
    "webrtc",
    "whip",
    "whep",
    "real-time",
    "streaming",
    "video",
    "live",
    "cdn",
    "hls",
    "dash",
    "videojs",
    "videojs-plugin"
  ],
  "homepage": "https://github.com/ceebluetv/videojs-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceebluetv/videojs-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/ceebluetv/videojs-plugins/issues"
  },
  "module": "dist/videojs-plugins.es.js",
  "browser": "dist/videojs-plugins.js",
  "generator-videojs-plugin": {
    "version": "8.0.0"
  },
  "scripts": {
    "build": "npm-run-all -s clean -p build:*",
    "build-prod": "cross-env-shell NO_TEST_BUNDLE=1 'npm run build'",
    "build-test": "cross-env-shell TEST_BUNDLE_ONLY=1 'npm run build'",
    "build:css": "postcss -o dist/videojs-plugins.css --config scripts/postcss.config.js src/plugin.scss",
    "build:js": "rollup -c rollup.config.ts",
    "clean": "shx rm -rf ./dist ./test/dist ./cjs ./es && shx mkdir -p ./dist ./test/dist ./cjs ./es",
    "docs": "npm-run-all build docs:build docs:copy",
    "docs:build": "vitepress build docs",
    "docs:copy": "shx mkdir -p docs/.vitepress/dist/dist && shx cp -r docs/public/* docs/.vitepress/dist/ && shx cp -r dist/* docs/.vitepress/dist/dist/",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "lint": "npx eslint",
    "server": "karma start scripts/karma.conf.js --singleRun=false --auto-watch",
    "start": "npm-run-all -p server watch",
    "test": "vitest run --project ci",
    "test:browser": "vitest run --project browser",
    "test:chrome": "cross-env TEST_BROWSER=chrome vitest run --project browser",
    "test:firefox": "cross-env TEST_BROWSER=firefox vitest run --project browser",
    "test:edge": "cross-env TEST_BROWSER=edge vitest run --project browser",
    "test:safari": "cross-env TEST_BROWSER=safari vitest run --project browser",
    "test:open": "cross-env-shell TEST_HEADLESS=false vitest --project browser -w",
    "test:coverage": "vitest run --coverage",
    "prepare": "is-ci || husky install",
    "prepublishOnly": "npm-run-all build-prod",
    "posttest": "shx cat test/dist/coverage/text.txt",
    "update-changelog": "conventional-changelog -p videojs -i CHANGELOG.md -s",
    "version": "is-prerelease || npm run update-changelog && git add CHANGELOG.md",
    "watch": "vite build --watch",
    "watch:css": "npm run build:css -- -w"
  },
  "author": "Ceeblue B.V.",
  "license": "AGPL-3.0-or-later",
  "vjsstandard": {
    "ignore": [
      "es",
      "cjs",
      "dist",
      "docs",
      "test/dist"
    ]
  },
  "files": [
    "cjs/",
    "dist/",
    "docs/",
    "es/"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": "vjsstandard --fix",
    "README.md": "doctoc --notitle"
  },
  "dependencies": {
    "@ceeblue/webrtc-client": "^4.1.0",
    "global": "^4.4.0",
    "video.js": "^8.22.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@html-eslint/eslint-plugin": "^0.39.0",
    "@html-eslint/parser": "^0.39.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-multi-entry": "^6.0.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@videojs/generator-helpers": "^3.2.0",
    "@vitest/browser": "^3.1.1",
    "@vitest/coverage-v8": "^3.1.2",
    "@vitest/ui": "^3.1.1",
    "@wdio/cli": "^9.12.7",
    "@wdio/local-runner": "^9.12.7",
    "@wdio/mocha-framework": "^9.12.6",
    "@wdio/spec-reporter": "^9.12.6",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.25.1",
    "eslint-config-videojs": "^6.1.0",
    "eslint-plugin-headers": "^1.2.1",
    "eslint-plugin-jsdoc": "^50.6.10",
    "eslint-plugin-json-light": "^1.0.3",
    "eslint-plugin-markdown": "^5.1.0",
    "globals": "^16.0.0",
    "husky": "~8.0.3",
    "is-ci": "~3.0.0",
    "jsdoc": "^4.0.4",
    "jsdom": "^26.1.0",
    "lint-staged": "~15.2.0",
    "markdown-it-container": "^4.0.0",
    "nyc": "^15.1.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^8.3.1",
    "rollup": "^4.40.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "rollup-plugin-istanbul": "^5.0.0",
    "semantic-release": "~24.1.2",
    "sinon": "^11.1.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "update": "^0.4.2",
    "videojs-generate-postcss-config": "^1.0.1",
    "videojs-generator-verify": "^4.1.3",
    "videojs-standard": "^9.1.0",
    "vite-plugin-monaco-editor": "1.1.0",
    "vitepress": "^1.6.3",
    "vitest": "^3.1.1",
    "webdriverio": "^9.12.5"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}
